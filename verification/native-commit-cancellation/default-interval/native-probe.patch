+// Test-only commit-hook gate; production progress interval is unchanged.
+static std::atomic<int> testCommitProbe{0};
+extern "C" JNIEXPORT void JNICALL Java_net_zetetic_database_sqlcipher_NativeCommitProbe_arm(JNIEnv*, jclass) { testCommitProbe.store(1); }
+extern "C" JNIEXPORT jint JNICALL Java_net_zetetic_database_sqlcipher_NativeCommitProbe_phase(JNIEnv*, jclass) { return testCommitProbe.load(); }
+static int testCommitHook(void* data) {
+    auto* connection = static_cast<SQLiteConnection*>(data);
+    testCommitProbe.store(2);
+    for (int i = 0; i < 10000 && !connection->canceled; ++i) usleep(1000);
+    testCommitProbe.store(connection->canceled ? 3 : 4);
+    return 0;
+}
